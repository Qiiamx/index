<%- include('partials/head') %>

<section class="page-head">
  <h1><%= mode === 'create' ? '新建文件夹' : '编辑文件夹' %></h1>
  <a class="link" href="/library">返回追番</a>
</section>

<form class="card form" method="post" action="<%= mode === 'create' ? '/folders' : '/folders/' + folder.id %>">
  <%- include('partials/folder-fields', { showTagCreate: true, showParentCreate: true }) %>
  <div class="form-actions">
    <button class="button" type="submit">保存</button>
    <a class="button secondary" href="<%= folder ? '/folders/' + folder.id : '/library' %>">取消</a>
  </div>
</form>

<% if (mode === 'edit') { %>
<form class="card form" method="post" action="/folders/<%= folder.id %>/delete" onsubmit="return confirm('删除这个文件夹及其子文件夹？逻辑条目会删除，本地文件不会删除；指向这些文件夹的规则会被禁用。')">
  <button class="button danger" type="submit">删除文件夹</button>
</form>
<% } %>

<%- include('partials/foot') %>
