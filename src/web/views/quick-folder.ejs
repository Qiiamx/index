<form class="form quick-form"
      hx-post="<%= action %>"
      hx-target="this"
      hx-swap="outerHTML">
  <h2>新建文件夹</h2>
  <% if (error) { %><div class="error"><%= error %></div><% } %>
  <%- include('partials/folder-fields', { showTagCreate: false }) %>
  <div class="form-actions">
    <button class="button" type="submit">创建</button>
    <button class="button secondary" type="button"
            onclick="document.getElementById('quick-dialog').close()">取消</button>
  </div>
</form>
